# LLM providers — 禁止提交真实 key
PRIZM_DEFAULT_MODEL=qwen-plus
# 显式指定 OpenAI 兼容网关地址；不填则用 provider 默认
PRIZM_LLM_API_BASE=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=

# 额度 / 会话限制
PRIZM_DAILY_TOKEN_BUDGET=200000
PRIZM_SESSION_TURN_LIMIT=30

# 执行限额
PRIZM_DUCKDB_MEMORY_LIMIT=1GB
PRIZM_DUCKDB_THREADS=2
PRIZM_SQL_TIMEOUT_SECONDS=30
